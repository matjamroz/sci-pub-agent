# Paths
DATA_DIR=data
SQLITE_PATH=data/processed/publications.db
CHROMA_PATH=data/processed/chroma
EMBEDDING_MODEL=BAAI/bge-m3

# LLM (OpenAI-compatible; Ollama by default)
